<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs src/Game/Probe.cs natively, to compare with the WebAssembly build (rubikon/wasm) bit for bit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>rubikon-probe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Rubikon.csproj" />
  </ItemGroup>
</Project>
