# Bake scratch (extracted VPKs, decompiled lumps) and build output
.work/
bake/bin/
bake/obj/
rubikon/**/bin/
rubikon/**/obj/
web/dist/

# Baked maps are generated from the workshop VPKs by `lasers-bake` and are large (100+ MB each).
# Scenarios (web/public/scenarios) are hand-written and ARE committed.
web/public/maps/*/
web/public/maps/index.json

# Stock CS2 sounds, generated by `lasers-bake --stock-sounds web/public/sounds`
web/public/sounds/
# CS2's physics runtime, generated by `node tools/build-rubikon.mjs`
web/public/rubikon/

# Viewmodel assets copied from the vpkstuff weaponviewer bake (Z:\weaponviewer\fp), 21 MB
web/public/weapons/

# Third-person body (CT agent + knife glbs, generated by `lasers-bake --player web/public/player`) and its stance
# clips (tools/tp-pose.mjs): Valve content, ~18 MB
web/public/player/

# CS2 HUD icons + Stratum2, generated by `lasers-bake --panorama web/public/panorama` (Valve content)
web/public/panorama/

# GFL's boss hitmarker particle (fx/), generated by `lasers-bake --gfl <GFL's workshop .vpk> web/public/gfl` (GFL's content)
web/public/gfl/

# Tooling
node_modules/
*.log
.env
.env.*
!.env.example
.vs/
.idea/
.DS_Store
Thumbs.db
