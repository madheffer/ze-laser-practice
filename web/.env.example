# Copy to web/.env (gitignored) and fill in. Read by `npm run dev` / `play` / `host`, `npm run coop-server` and
# `npm run db:migrate`. Server-side only: nothing here reaches the page.

# Postgres for runs + leaderboards (README "Database"). Leave unset in dev to keep runs in memory.
# Add ?sslmode=require when the database is on another machine.
DATABASE_URL=postgres://lasers:change-me@localhost:5432/lasers

# Sign in through Steam (README "Sign in through Steam"). All optional in dev.
# SESSION_SECRET: 32+ random characters that sign the session cookie; without it sign-ins end on every restart.
SESSION_SECRET=
# STEAM_API_KEY: https://steamcommunity.com/dev/apikey, for players' Steam names (without it: "Steam player 1234").
STEAM_API_KEY=
# STEAM_RETURN_HOST: the public origin Steam sends players back to, e.g. https://lasers.example.com. Unset: the
# request's own host (fine on localhost and a single-domain host).
STEAM_RETURN_HOST=
