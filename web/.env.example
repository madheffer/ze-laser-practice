# Copy to web/.env (gitignored) and fill in. Read by `npm run dev` / `play` / `host`, `npm run coop-server` and
# `npm run db:migrate`. Server-side only: nothing here reaches the page.

# Postgres for runs + leaderboards (README "Database"). Leave unset in dev to keep runs in memory.
# Add ?sslmode=require when the database is on another machine.
DATABASE_URL=postgres://lasers:change-me@localhost:5432/lasers
