{
  "name": "lasers-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --config vite.stable.config.js",
    "build": "vite build",
    "preview": "vite preview",
    "play": "vite build && vite preview",
    "host": "vite build && vite preview --host",
    "coop-server": "node --env-file-if-exists=.env server/main.js",
    "bake": "node ../tools/bake-map.mjs",
    "index-maps": "node ../tools/index-maps.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js"
  },
  "dependencies": {
    "pg": "8.13.1",
    "three": "0.170.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "vite": "6.0.7"
  }
}
