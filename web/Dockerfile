# The whole site in one container: the built game, the co-op server (/coop), the read-only API (/api/).
#
#   docker build -t lasers web
#   docker run -p 8080:8080 -e DATABASE_URL=postgres://... -v /path/to/baked:/assets:ro lasers
#
# The baked content (maps, sounds, weapons, panorama, player: generated by lasers-bake, several GB, Valve content)
# is NOT in the image: mount a folder holding those five folders at /assets (README "Hosting").
FROM node:22.12.0-alpine3.20 AS build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx vite build && npm prune --omit=dev

FROM node:22.12.0-alpine3.20
ENV NODE_ENV=production PORT=8080
WORKDIR /web
COPY --from=build /web/package.json ./
COPY --from=build /web/node_modules ./node_modules
COPY --from=build /web/dist ./dist
COPY --from=build /web/server ./server
COPY --from=build /web/src ./src
COPY --from=build /web/public/scenarios ./public/scenarios
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["node", "server/main.js", "--static", "dist", "--static", "/assets", "--maps", "/assets/maps"]
